class Node {
  init(v, next) {
    this.v = v;
    this.next = next;
  }
}

fun build(n) {
  var head = nil;
  var i = 0;
  while (i < n) {
    head = Node(i, head);
    i = i + 1;
  }
  return head;
}

fun total(l) {
  var s = 0;
  while (l != nil) {
    s = s + l.v;
    l = l.next;
  }
  return s;
}

fun mapAdd(k) {
  fun f(x) {
    return x + k;
  }
  return f;
}

fun main() {
  var round = 0;
  var acc = 0;
  var f = mapAdd(3);
  while (round < 100) {
    var l = build(2000);
    acc = acc + total(l) + f(round);
    round = round + 1;
  }
  print acc;
}
main();

