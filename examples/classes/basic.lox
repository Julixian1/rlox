// basic.lox
// Demuestra declaracion de clases, creacion de instancias, propiedades dinamicas y estado independiente.

class Point {}

// 1. Declaracion e instanciacion
var p1 = Point();
p1.x = 3;
p1.y = 4;

var p2 = Point();
p2.x = 10;
p2.y = 20;

print "--- Propiedades iniciales ---";
print p1.x;
print p1.y;
print p2.x;
print p2.y;

// 2. Estado independiente entre instancias
p1.x = p1.x + 1;
print "--- Estado independiente tras mutar p1.x ---";
print p1.x;
print p2.x;

// 3. Calculos con propiedades
var sum = p1.x + p1.y + p2.x + p2.y;
print "--- Suma de coordenadas ---";
print sum;

